# =============================================================================
# Flood Forensics — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# API authentication (development)
API_KEY=dev-api-key-change-in-production

# -----------------------------------------------------------------------------
# Supabase (backend only — never expose service role to frontend)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# AI Provider: mock | granite
# -----------------------------------------------------------------------------
AI_PROVIDER=mock

# IBM watsonx / Granite (required when AI_PROVIDER=granite)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# -----------------------------------------------------------------------------
# Frontend (public — safe for browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional Supabase client auth (anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
